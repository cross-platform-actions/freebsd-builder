if [ -e /dev/vtbd0 ]; then
  PARTITIONS=vtbd0
elif [ -e /dev/ada0 ]; then
  PARTITIONS=ada0
elif [ -e /dev/da0 ]; then
  PARTITIONS=da0
else
  echo "ERROR: There is no disk available for installation" >&2
  exit 1
fi

DISTRIBUTIONS='kernel.txz base.txz'
export BSDINSTALL_DISTSITE="${BSDINSTALL_DISTSITE:-http://ftp.freebsd.org/pub/FreeBSD/releases/$(uname -m)/$(uname -p)/$(uname -r)}"
HOSTNAME=freebsd

#!/bin/sh

set -exu

configure_network() {
cat <<EOF > /etc/resolv.conf
nameserver 8.8.8.8
EOF

sysrc ifconfig_DEFAULT=DHCP
sysrc sshd_enable=YES
}

configure_ssh() {
  tee -a /etc/ssh/sshd_config <<EOF
PermitRootLogin yes
PasswordAuthentication yes
PermitEmptyPasswords yes
UseDNS no
AcceptEnv *
EOF

  # FreeBSD's pam_unix.so rejects empty passwords unless `nullok` is set,
  # which would otherwise prevent passwordless SSH login for the secondary user.
  sed -i '' '/^auth.*pam_unix\.so/ s/$/ nullok/' /etc/pam.d/sshd
}

configure_root_user() {
  echo "$ROOT_PASSWORD" | pw usermod root -h 0
}

configure_timezone() {
  /bin/cp /usr/share/zoneinfo/UTC /etc/localtime
  /usr/bin/touch /etc/wall_cmos_clock
  /sbin/adjkerntz -a
  /usr/sbin/ntpdate -u 0.pool.ntp.org
}

configure_ntpd() {
  sysrc ntpd_enable=YES
}

set_hostname() {
  sysrc hostname='runnervmg1sw1.local'
}

configure_network
configure_ssh
configure_root_user
configure_timezone
configure_ntpd
set_hostname

if [ "$(uname -p)" = "riscv64" ]; then
  # On riscv64 the installer boots from the ISO in single-user mode.
  # After install, rebooting may not reliably boot from the installed disk.
  # Instead, start sshd here (in the chroot of the installed system) and
  # block, allowing Packer to SSH in, run provisioners, and then shut down.
  /etc/rc.d/sshd onestart
  while true; do sleep 3600; done
else
  reboot
fi
